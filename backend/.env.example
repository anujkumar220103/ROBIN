APP_NAME=ROBIN AI
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Neon PostgreSQL — pooled connection (application use)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Neon direct connection — recommended for Alembic migrations (optional)
DATABASE_DIRECT_URL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

AUTH_COOKIE_NAME=robin_access_token
CSRF_COOKIE_NAME=robin_csrf_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=200
MAX_DOCUMENTS_PER_COMPANY=100
MAX_CHUNKS_PER_DOCUMENT=5000

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=30
CHROMA_PERSIST_DIR=chroma_data
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
DEFAULT_TOP_K=5
MAX_TOP_K=20
MAX_CONCURRENT_INGESTIONS=1
MAX_QUERY_LENGTH=1000

# --- LLM Provider Configuration ---
LLM_PROVIDER_ORDER=gemini,groq,openrouter
LLM_ENABLED_PROVIDERS=gemini,groq,openrouter

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Generation settings
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1024
LLM_PROVIDER_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_TOTAL_TIMEOUT_SECONDS=60

# Retrieval settings
RAG_RETRIEVAL_TOP_K=10
RAG_CONTEXT_TOP_K=5
RAG_MIN_SIMILARITY=0.35
RAG_MAX_CONTEXT_TOKENS=3000
RAG_MAX_QUESTION_LENGTH=1000

# Conversation
RAG_MAX_HISTORY_MESSAGES=6
RAG_MAX_HISTORY_TOKENS=1000

# Chat rate limiting
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_MAX_CONCURRENT_REQUESTS=2

WIDGET_SESSION_SECRET=
WIDGET_SESSION_TTL_MINUTES=30
WIDGET_SESSION_ISSUER=robin-widget
WIDGET_SESSION_AUDIENCE=robin-public-chat
PUBLIC_WIDGET_URL=http://localhost:5173/widget
PUBLIC_SESSION_RATE_LIMIT_PER_MINUTE=10
PUBLIC_CHAT_RATE_LIMIT_PER_MINUTE=5
PUBLIC_CHAT_IP_RATE_LIMIT_PER_MINUTE=20
PUBLIC_CHAT_COMPANY_RATE_LIMIT_PER_MINUTE=30
PUBLIC_CHAT_COMPANY_DAILY_LIMIT=200
PUBLIC_CHAT_GLOBAL_DAILY_LIMIT=1000
PUBLIC_CHAT_MAX_CONCURRENT_PER_COMPANY=2
PUBLIC_CHAT_MAX_CONCURRENT_GLOBAL=5

# Cloudinary private PDF storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=robin-documents
