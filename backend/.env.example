APP_NAME=ROBIN AI
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Neon PostgreSQL — pooled connection (application use)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Neon direct connection — recommended for Alembic migrations (optional)
DATABASE_DIRECT_URL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

AUTH_COOKIE_NAME=robin_access_token
CSRF_COOKIE_NAME=robin_csrf_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=200
MAX_DOCUMENTS_PER_COMPANY=100
MAX_CHUNKS_PER_DOCUMENT=5000

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=30
CHROMA_PERSIST_DIR=chroma_data
DEFAULT_TOP_K=5
MAX_TOP_K=20
MAX_CONCURRENT_INGESTIONS=1
MAX_QUERY_LENGTH=1000
